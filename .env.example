# Apex Routes — deploymentconfiguratie
# Routing heeft publieke fallbacks; verkoop, e-mail en juridische identiteit
# vereisen in productie de betreffende waarden hieronder.

# Eigen routing-engine (OSRM). Geef alléén de host, zónder /route/v1 —
# de server plakt zelf /route/v1/{profile}/{coords} achter de basis-URL.
# Voorbeeld: OSRM_BASE_URL=https://jouw-server
OSRM_BASE_URL=

# Eigen Nominatim-instantie (voldoe aan de usage policy).
# Voorbeeld: NOMINATIM_BASE_URL=https://nominatim.jouw-domein.nl
NOMINATIM_BASE_URL=

# Echte fiets- en wandelrouting via OpenRouteService (gratis account,
# ~2.000 requests/dag). Zonder key vallen fiets/wandelen terug op de
# offline-schatting; auto en motor lopen sowieso via OSRM.
# Key aanmaken: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
# Alleen nodig voor een eigen ORS-instantie. Standaard api.heigit.org —
# api.openrouteservice.org is sinds april 2026 deprecated.
ORS_BASE_URL=https://api.heigit.org/openrouteservice

# Eigen bron voor het hoogteprofiel (standaard de gratis Open-Meteo API).
ELEVATION_BASE_URL=https://api.open-meteo.com

# Optionele LLM-laag voor nog slimmere vrije-tekst parsing.
# Elke OpenAI-compatibele API werkt (OpenAI, Groq, OpenRouter, Ollama, ...).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Publieke site-URL voor Stripe-returnlinks.
NEXT_PUBLIC_SITE_URL=https://routes.apexclusive.nl

# --- Juridische exploitant (voor productie invullen; zichtbaar op juridische pagina's) ---
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_REGISTRATION=
LEGAL_VAT_ID=

# --- Omzet: Stripe Checkout (aanbevolen) ---
# De geheime sleutel blijft ALTIJD server-side; gebruik nooit NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
# Endpoint: https://routes.apexclusive.nl/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SUPPORTER=
STRIPE_PRICE_MONTH=
STRIPE_PRICE_YEAR=
STRIPE_PRICE_LIFE=
# Activeer ook Stripe Customer Portal in het Dashboard voor self-service opzeggen.
# Alleen aanzetten als Stripe Tax op het account is geconfigureerd.
STRIPE_AUTOMATIC_TAX=false

# Gebruik voor entitlements geen statische Payment Links: die kunnen niet veilig
# aan een anonieme installatie worden gekoppeld en zijn daarom niet actief in de UI.

# Demo-codes zijn in productie standaard uitgeschakeld. Alleen voor previews.
NEXT_PUBLIC_ENABLE_DEMO_CODES=false

# --- Omzet: relevante reispartners ---
# Aanmelden via Booking.com/CJ en GetYourGuide Partner Portal.
NEXT_PUBLIC_BOOKING_AID=
NEXT_PUBLIC_GETYOURGUIDE_PARTNER_ID=

# --- Meetbare funnel, zonder route-inhoud of persoonsgegevens ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Alleen wijzigen bij een eigen Plausible-proxy of self-hosted installatie.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# --- Transactionele mail, leads, feedback en herroepingsbevestiging (Resend) ---
RESEND_API_KEY=
# Voorbeeld: Apex Routes <routes@updates.jouwdomein.nl>
RESEND_FROM=
PARTNER_EMAIL_TO=partners@apexclusive.nl
FEEDBACK_EMAIL_TO=partners@apexclusive.nl
BILLING_EMAIL_TO=partners@apexclusive.nl
WITHDRAWAL_EMAIL_TO=partners@apexclusive.nl
