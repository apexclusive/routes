{
  "name": "Apex Routes — AI Route Planner",
  "short_name": "Apex Routes",
  "description": "Plan de mooiste route voor motor, auto, fiets of wandelen in gewone taal. Exporteer naar Google Maps, Waze of GPX.",
  "lang": "nl",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#050507",
  "theme_color": "#050507",
  "categories": [
    "navigation",
    "travel",
    "utilities"
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/gpx+xml": [
          ".gpx"
        ],
        "application/vnd.google-earth.kml+xml": [
          ".kml"
        ],
        "application/json": [
          ".geojson",
          ".json"
        ],
        "application/xml": [
          ".xml",
          ".tcx"
        ]
      }
    }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Planner",
      "url": "/",
      "description": "Direct plannen"
    },
    {
      "name": "Vertrek-checklist",
      "url": "/checklist",
      "description": "Checklist vóór vertrek"
    },
    {
      "name": "Forum",
      "url": "/forum",
      "description": "Community"
    },
    {
      "name": "Kalender",
      "url": "/kalender",
      "description": "Events per maand"
    }
  ]
}