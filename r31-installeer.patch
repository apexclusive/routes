#!/usr/bin/env bash
# ============================================================
#  APEX ROUTES - RONDE 31 INSTALLER  (rev 4, 2026-09-04)
#  Inhoud: klimbibliotheek (/klimmen, 28 cols incl. Alpen),
#  ritten-bibliotheek (/ritten, 10 dagritten), SiteMenu op
#  elke pagina, Rit van de week op de landing, FAQ+schema,
#  share-knoppen, OG-kaarten, deelkaart, adverteer-pagina,
#  monetize-addities (partner-mailto + booking-knoppen).
#
#  Gebruik (in de repo-root, na upload van dit bestand):
#      bash r31-installeer.patch
#  Daarna verifieren:
#      npx tsc --noEmit && npm test && npm run lint && npm run build
#  En bij groen resultaat committen en op main zetten.
#
#  Veilig herhaalbaar: aanwezige wijzigingen worden overgeslagen;
#  ontbrekende ankers worden als HANDMATIG-punt geprint.
#  (r31-full/ hulpbestanden worden na afloop opgeruimd.)
# ============================================================
set -uo pipefail
if [ ! -f package.json ] || [ ! -d src ]; then
  echo "FOUT: voer dit uit in de repo-root (package.json + src/ aanwezig)." >&2
  exit 1
fi
START=$(grep -n "^# BEGIN-B64" "$0" | head -1 | cut -d: -f1)
EIND=$(grep -n "^# END-B64" "$0" | head -1 | cut -d: -f1)
sed -n "$((START+1)),$((EIND-1))p" "$0" | sed 's/^# //' | base64 -d > /tmp/r31-nieuw.tgz \
  && tar xzf /tmp/r31-nieuw.tgz \
  && echo "OK: 28 bestanden uitgepakt (24 nieuwe + 4 r31-full hulpkopieen)" \
  || { echo "FOUT: uitpakken mislukt" >&2; exit 1; }

python3 << 'PYEOF'
import re, os, shutil

handmatig = []
def ok(msg): print("OK:", msg)
def sla(msg): print("SKIP:", msg)
def hand(msg): handmatig.append(msg)

def lees(p):
    return open(p, encoding="utf-8").read()
def schrijf(p, s):
    open(p, "w", encoding="utf-8").write(s)

def na_laatste_import(s, tekst):
    imports = list(re.finditer(r'^import[^\n]*\n', s, re.M))
    if not imports:
        return None, None
    m = imports[-1]
    return m.end(), s[:m.end()] + tekst + s[m.end():]

# ---------- 1. calendar.ts: EventCountry uitbreiden (robust, elke ledenlijst) ----------
p = "src/lib/calendar.ts"
if os.path.exists(p):
    s = lees(p)
    if '"IT"' in s and '"AT"' in s and "EventCountry" in s:
        sla("EventCountry al uitgebreid")
    else:
        m = re.search(r'export type EventCountry = [^;]+;', s)
        if m:
            nieuw = 'export type EventCountry = "NL" | "BE" | "LU" | "DE" | "FR" | "IT" | "CH" | "AT";'
            schrijf(p, s[:m.start()] + nieuw + s[m.end():])
            ok("EventCountry += IT/CH/AT (was: %s)" % m.group(0)[:60])
        else:
            hand("calendar.ts: EventCountry-regel niet gevonden - handmatig uitbreiden met | \"IT\" | \"CH\" | \"AT\"")
else:
    hand("calendar.ts bestaat niet - paden checken")

# ---------- 2. monetize.ts: buildPartnerMailto (of hele bestand plaatsen) ----------
p = "src/lib/monetize.ts"
if not os.path.exists(p):
    if os.path.exists("r31-full/monetize.ts"):
        shutil.copy("r31-full/monetize.ts", p); ok("monetize.ts geplaatst vanuit r31-full (bestand bestond nog niet)")
    else:
        hand("monetize.ts ontbreekt en r31-full/monetize.ts ontbreekt")
else:
    s = lees(p)
    if "buildPartnerMailto" in s: sla("buildPartnerMailto aanwezig")
    else:
        s += '''
/** Mailto voor partner-aanvragen (zero-backend lead-capture). */
export function buildPartnerMailto(
  bedrijf: string,
  email: string,
  pakket: string,
  bericht: string
): string {
  const subject = `Partnerschapsaanvraag \u2014 ${pakket} \u2014 ${bedrijf.trim() || "onbekend"}`;
  const body = [
    `Bedrijf: ${bedrijf.trim()}`,
    `E-mail: ${email.trim()}`,
    `Pakket: ${pakket}`,
    "",
    bericht.trim(),
  ].join("\\n");
  return `mailto:partners@apexclusive.nl?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
}
'''
        schrijf(p, s); ok("monetize.ts += buildPartnerMailto")

# ---------- 3. share.ts: buildShareUrls (of hele bestand plaatsen) ----------
p = "src/lib/share.ts"
if not os.path.exists(p):
    if os.path.exists("r31-full/share.ts"):
        shutil.copy("r31-full/share.ts", p); ok("share.ts geplaatst vanuit r31-full (bestand bestond nog niet)")
    else:
        hand("share.ts ontbreekt en r31-full/share.ts ontbreekt")
else:
    s = lees(p)
    if "buildShareUrls" in s: sla("buildShareUrls aanwezig")
    else:
        s += '''
/* ---------- social-share links (mond-tot-mond) ---------- */

export type ShareDoelen = {
  x: string;
  whatsapp: string;
  facebook: string;
  mail: string;
};

export function buildShareUrls(titel: string, url: string, tekst?: string): ShareDoelen {
  const t = encodeURIComponent(titel);
  const u = encodeURIComponent(url);
  const te = encodeURIComponent(tekst ?? titel);
  return {
    x: `https://twitter.com/intent/tweet?text=${t}&url=${u}`,
    whatsapp: `https://wa.me/?text=${te}%20${u}`,
    facebook: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
    mail: `mailto:?subject=${t}&body=${te}%0A%0A${u}`,
  };
}
'''
        schrijf(p, s); ok("share.ts += buildShareUrls")

# ---------- 4. i18n.ts: types + rotw + footer-keys ----------
p = "src/lib/i18n.ts"
s = lees(p)
if "rotw:" in s: sla("i18n rotw aanwezig")
else:
    a1 = "  forumBand: { title: string; sub: string; cta: string };"
    if a1 in s:
        s = s.replace(a1, a1 + "\n  rotw: { label: string; plan: string; copied: string; hotel: string; climbs: string; meer: string };", 1)
    else:
        hand("i18n.ts: rotw-type handmatig toevoegen aan het LandingStrings-type")
    rotw = [
        '    rotw: { label: "Rit van de week", plan: "Plan deze rit", copied: "Gekopieerd", hotel: "Verblijf", climbs: "Klimmen onderweg", meer: "Alle ritten" },',
        '    rotw: { label: "Ride of the week", plan: "Plan this ride", copied: "Copied", hotel: "Stay", climbs: "Climbs along the way", meer: "All rides" },',
        '    rotw: { label: "Sortie de la semaine", plan: "Planifier", copied: "Copi\u00e9", hotel: "H\u00e9bergement", climbs: "Cols en route", meer: "Toutes les sorties" },',
        '    rotw: { label: "Tour der Woche", plan: "Diese Tour planen", copied: "Kopiert", hotel: "Unterkunft", climbs: "Anstiege unterwegs", meer: "Alle Touren" },',
    ]
    pos = 0; toegevoegd = 0
    for blok in rotw:
        m = re.search(r"forumBand: \{[^}]*\},\n", s[pos:])
        if not m: break
        abs_eind = pos + m.end()
        s = s[:abs_eind] + blok + "\n" + s[abs_eind:]
        pos = abs_eind + len(blok) + 1
        toegevoegd += 1
    if toegevoegd == 4: ok("i18n rotw in 4 talen")
    else: hand("i18n.ts: rotw maar %d/4 talen - rest handmatig" % toegevoegd)
    footers = [
        '      klimmen: "Klimbibliotheek",\n      adverteren: "Adverteren",\n      ritten: "Ritten",',
        '      klimmen: "Climb library",\n      adverteren: "Advertise",\n      ritten: "Rides",',
        '      klimmen: "Biblioth\u00e8que de cols",\n      adverteren: "Publicit\u00e9",\n      ritten: "Sorties",',
        '      klimmen: "Anstiegs-Bibliothek",\n      adverteren: "Werbung",\n      ritten: "Touren",',
    ]
    git_m = list(re.finditer(r'\n      gpx: "[^"]*",', s))
    chk_m = list(re.finditer(r'\n      checklist: "[^"]*",', s))
    bron = git_m if len(git_m) == 4 else (chk_m if len(chk_m) == 4 else None)
    if bron:
        for m, blok in zip(reversed(bron), reversed(footers)):
            s = s[:m.end()] + "\n" + blok + s[m.end():]
        ok("i18n footer-labels in 4 talen")
    else:
        hand("i18n.ts: footer-labels handmatig toevoegen (klimmen/adverteren/ritten per taal)")
    a2 = "    gpx: string;"
    if a2 in s and "ritten: string;" not in s:
        s = s.replace(a2, a2 + "\n    klimmen: string;\n    adverteren: string;\n    ritten: string;", 1)
    elif "ritten: string;" not in s:
        hand("i18n.ts: footer-type-keys (klimmen/adverteren/ritten: string) handmatig toevoegen")
    schrijf(p, s)

# ---------- 5. Landing.tsx: RotwBand + footer-links ----------
p = "src/components/Landing.tsx"
s = lees(p)
if "RotwBand" in s: sla("Landing RotwBand aanwezig")
else:
    a = 'import Poll from "./Poll";'
    if a in s:
        s = s.replace(a, a + '\nimport RotwBand from "./RotwBand";', 1)
    else:
        pos, s2 = na_laatste_import(s, 'import RotwBand from "./RotwBand";')
        if pos is None: hand("Landing.tsx: RotwBand-import handmatig toevoegen")
        else: s = s2
    idx = s.find("{t.forumBand.title}")
    if idx > -1:
        sec = s.rfind("<section", 0, idx)
        if sec > -1:
            s = s[:sec] + "      <RotwBand />\n\n" + s[sec:]
            ok("Landing: <RotwBand /> v\u00f3\u00f3r de forum-band geplaatst")
        else:
            hand("Landing.tsx: <RotwBand /> handmatig v\u00f3\u00f3r de forum-band-sectie plaatsen")
    else:
        anker = '      <section className="relative z-10 px-4 sm:px-6 py-16 max-w-6xl mx-auto">\n        <motion.div'
        if s.count(anker) >= 1:
            s = s.replace(anker, "      <RotwBand />\n\n" + anker, 1)
            ok("Landing: <RotwBand /> geplaatst (fallback-ancker)")
        else:
            hand("Landing.tsx: <RotwBand /> handmatig plaatsen (bijv. v\u00f3\u00f3r de forum-sectie of pricing)")
    schrijf(p, s)
s = lees(p)
if 'href: "/ritten"' not in s:
    a = '{ href: "/checklist", icon: ClipboardCheck, label: t.footer.checklist },'
    b = '{ href: "/gpx", icon: FileDown, label: t.footer.gpx },'
    anker = a if s.count(a) == 1 else (b if s.count(b) == 1 else None)
    if anker:
        extra = (
            '\n                  { href: "/ritten", icon: Route, label: t.footer.ritten },'
            '\n                  { href: "/klimmen", icon: Mountain, label: t.footer.klimmen },'
            '\n                  { href: "/adverteren", icon: Megaphone, label: t.footer.adverteren },'
        )
        s = s.replace(anker, anker + extra, 1)
        for ic in ["Route", "Mountain", "Megaphone"]:
            if not re.search(r"\b" + ic + r"[,\n]", s.split('} from "lucide-react"')[0]):
                s = s.replace('\n} from "lucide-react";', ",\n  " + ic + ',\n} from "lucide-react";', 1)
        s = re.sub(r",(\s*,)+", ",", s)  # dubbele komma's uit invoegen opruimen
        schrijf(p, s); ok("Landing: footer-links ritten/klimmen/adverteren")
    else:
        hand("Landing.tsx: footer-links (/ritten,/klimmen,/adverteren) handmatig toevoegen + lucide-imports Route/Mountain/Megaphone")

# ---------- 6. SiteMenu-injectie in 7 componenten ----------
for p in ["src/components/Kalender.tsx", "src/components/Forum.tsx", "src/components/Discover.tsx",
          "src/components/Advisor.tsx", "src/components/GpxGuide.tsx", "src/components/Checklist.tsx",
          "src/components/Ritbank.tsx"]:
    if not os.path.exists(p):
        hand(p + " bestaat niet - SiteMenu-injectie overslaan"); continue
    s = lees(p)
    if "SiteMenu" in s: sla("SiteMenu al in " + os.path.basename(p)); continue
    geplaatst = False
    try:
        i_nav = s.index("site-nav")
        for pat in ['<div className="flex items-center gap-2;">', '<div className="flex items-center gap-3;">']:
            try:
                i_div = s.index(pat, i_nav)
                ins = i_div + len(pat)
                s = s[:ins] + "\n          <SiteMenu />" + s[ins:]
                geplaatst = True; break
            except ValueError:
                continue
    except ValueError:
        pass
    if not geplaatst:
        try:
            i_nav = s.index("<nav")
            i_end = s.index("</nav>", i_nav)
            s = s[:i_end] + "  <SiteMenu />\n      " + s[i_end:]
            geplaatst = True
        except ValueError:
            hand(p + ": nav niet gevonden - <SiteMenu /> handmatig in de sticky nav plaatsen + import")
            continue
    if 'import Logo from "./Logo";' in s:
        s = s.replace('import Logo from "./Logo";', 'import Logo from "./Logo";\nimport SiteMenu from "./SiteMenu";', 1)
    else:
        pos, s2 = na_laatste_import(s, 'import SiteMenu from "./SiteMenu";')
        if pos is not None: s = s2
        else: hand(p + ": SiteMenu-import handmatig toevoegen (<SiteMenu /> staat er al)")
    schrijf(p, s); ok("SiteMenu in " + os.path.basename(p))

# ---------- 7. sitemap.ts ----------
p = "src/app/sitemap.ts"
if os.path.exists(p):
    s = lees(p)
    if "/klimmen" in s: sla("sitemap al uitgebreid")
    else:
        entries = ['    { path: "/gpx", priority: 0.8, freq: "monthly" },',
                   '    { path: "/checklist", priority: 0.7, freq: "monthly" },',
                   '    { path: "/forum", priority: 0.8, freq: "monthly" },',
                   '    { path: "/kalender", priority: 0.9, freq: "daily" },']
        anker = next((e for e in entries if s.count(e) == 1), None)
        if anker:
            nieuw = (anker + '\n'
                     '    { path: "/ritten", priority: 0.8, freq: "monthly" },\n'
                     '    { path: "/klimmen", priority: 0.8, freq: "monthly" },\n'
                     '    ...RITTEN.map((r) => ({\n      path: `/ritten/${r.id}`,\n      priority: 0.7,\n      freq: "monthly" as const,\n    })),\n'
                     '    ...CLIMBS.map((c) => ({\n      path: `/klimmen/${c.id}`,\n      priority: 0.7,\n      freq: "monthly" as const,\n    })),')
            s = s.replace(anker, nieuw, 1)
        else:
            m = re.search(r'\n(\s*)\];', s)
            if m:
                ins = ('\n    { path: "/ritten", priority: 0.8, freq: "monthly" },\n    { path: "/klimmen", priority: 0.8, freq: "monthly" },')
                s = s[:m.start()] + ins + s[m.start():]
            else:
                hand("sitemap.ts: /ritten-/klimmen-entries handmatig toevoegen")
        if 'from "@/lib/climbs";' not in s:
            pos, s2 = na_laatste_import(s, 'import { CLIMBS } from "@/lib/climbs";\nimport { RITTEN } from "@/lib/ritten";')
            if pos is not None: s = s2
            else: hand("sitemap.ts: imports CLIMBS/RITTEN handmatig toevoegen")
        schrijf(p, s); ok("sitemap +/ritten +/klimmen + 38 detail-URLs")

# ---------- 8. sw.js versie bump ----------
p = "public/sw.js"
if os.path.exists(p):
    s = lees(p)
    m = re.search(r'VERSION = "v(\d+)"', s)
    if m:
        nieuw = int(m.group(1)) + 1
        schrijf(p, s.replace(m.group(0), 'VERSION = "v%d"' % nieuw))
        ok("sw.js versie -> v%d" % nieuw)
    else:
        hand("sw.js: VERSION niet gevonden - bump handmatig")

# ---------- 9. llms.txt ----------
p = "public/llms.txt"
if os.path.exists(p):
    s = lees(p)
    if "/ritten :" in s: sla("llms.txt al uitgebreid")
    else:
        s += ("\n- /ritten : 10 samengestelde dagritten (Mergellandroute, Ardennen-Ourthe, kasseienklassieker, Eifel/Nordschleife, "
              "Sauerland, Moezel, Route des Cretes, Schwarzwaldhochstrasse B500, Stelvio, Grossglockner) met km/rijtijd/hoogtepunten "
              "en eigen detailpagina's (/ritten/<id>)\n"
              "- /klimmen : klimbibliotheek - 28 beklimmingen NL/BE/DE/FR/IT/CH/AT met eigen detailpagina's (/klimmen/<id>), "
              "seizoensdata en FAQ\n"
              "- /adverteren : partnerschappen met aanvraagformulier (mailto partners@apexclusive.nl)\n")
        schrijf(p, s); ok("llms.txt aangevuld")

# ---------- 10. README ----------
p = "README.md"
if os.path.exists(p) and "Ronde 31:" not in lees(p):
    schrijf(p, lees(p) + ("\n\n## Ronde 31: klimbibliotheek, ritten-bibliotheek, SiteMenu, FAQ+schema, deelkaart, monetize\n"
        "- /klimmen: 28 beklimmingen (Benelux + Alpen) met detailpagina's (stats, zwaarte-balk, seizoen, tol-badge, FAQ+JSON-LD, plan/hotel/deel-knop, OG-kaart)\n"
        "- /ritten: 10 dagritten met detailpagina's; Rit van de week op de landing (automatische weekrotatie)\n"
        "- SiteMenu (hamburger) op elke pagina; ShareButton (Web Share + WhatsApp/X/mail); DeelKaart (1080x1080 PNG download)\n"
        "- monetize: buildPartnerMailto; Booking-knoppen met sponsored-rel; FAQPage-schema op alle detailpagina's\n"))
    ok("README ronde 31 toegevoegd")

# ---------- 11. tests ----------
p = "src/lib/__tests__/share.test.ts"
if not os.path.exists(p) and os.path.exists("r31-full/share.test.ts"):
    shutil.copy("r31-full/share.test.ts", p); ok("share.test.ts geplaatst vanuit r31-full")
elif os.path.exists(p) and "buildShareUrls" not in lees(p):
    schrijf(p, lees(p) + '''
import { buildShareUrls } from "../share.ts";

test("share-links: alle doelen bevatten de ge-encodeerde url en titel", () => {
  const d = buildShareUrls("Mergellandroute", "https://routes.apexclusive.nl/ritten/mergellandroute");
  assert.ok(d.x.includes(encodeURIComponent("Mergellandroute")));
  assert.ok(d.whatsapp.includes("wa.me"));
  assert.ok(d.facebook.includes("sharer/sharer.php?u="));
  assert.ok(d.mail.startsWith("mailto:?subject="));
});

test("share-links: aangepaste tekst landt in whatsapp en mail", () => {
  const d = buildShareUrls("Stelvio", "https://x.nl/a", "Deze ga ik rijden");
  assert.ok(d.whatsapp.includes(encodeURIComponent("Deze ga ik rijden")));
  assert.ok(d.mail.includes("%0A%0A"));
});
''')
    ok("share-tests toegevoegd")

p = "src/lib/__tests__/monetize.test.ts"
if not os.path.exists(p) and os.path.exists("r31-full/monetize.test.ts"):
    shutil.copy("r31-full/monetize.test.ts", p); ok("monetize.test.ts geplaatst vanuit r31-full")
elif os.path.exists(p) and "buildPartnerMailto" not in lees(p):
    schrijf(p, lees(p) + '''
import { buildPartnerMailto } from "../monetize.ts";

test("monetize:partner-mailto bevat bedrijf, pakket en bericht", () => {
  const url = buildPartnerMailto("Cafe De Bende", "info@debende.be", "Event-promotie", "Dag APEX");
  assert.ok(url.startsWith("mailto:partners@apexclusive.nl?"));
  const params = new URLSearchParams(url.split("?")[1]);
  assert.ok(params.get("subject")?.includes("Event-promotie"));
  assert.ok(params.get("body")?.includes("Cafe De Bende"));
});
''')
    ok("mailto-test toegevoegd")

# ---------- opruimen ----------
if os.path.isdir("r31-full"):
    shutil.rmtree("r31-full")
    ok("r31-full/ hulpmap opgeruimd")

print()
if handmatig:
    print("=== HANDMATIG (%d) ===" % len(handmatig))
    for h in handmatig: print(" -", h)
else:
    print("=== Alles automatisch aangebracht ===")
PYEOF
echo ""
echo "Volgende stap: npx tsc --noEmit && npm test && npm run lint && npm run build"
echo "Bij groen: commit alles en zet het op main via de gebruikelijke git-werkwijze."
exit 0

